root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 120

[*.{js,mjs,json,html,css,yml,yaml,avsc}]
indent_size = 2

# Two trailing spaces are a line break in Markdown, and prose lines are not wrapped.
[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cmd,bat}]
end_of_line = crlf
