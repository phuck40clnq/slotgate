SERVICE_NAME=gateway-service
PORT=8080
SPRING_PROFILES_ACTIVE=
# Key set of auth-service that verifies every token; required
OAUTH_JWK_SET_URI=http://localhost:8082/oauth2/jwks
# Comma-separated origins allowed to call the gateway from a browser, each scheme://host[:port]
CORS_ALLOWED_ORIGINS=http://localhost:3000
