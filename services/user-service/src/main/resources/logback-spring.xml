<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ================= -->
    <!-- SPRING PROPERTIES -->
    <!-- ================= -->
    <springProperty scope="context"
                    name="SERVICE_NAME"
                    source="spring.application.name"/>
    <springProperty scope="context"
                    name="ACTIVE_PROFILE"
                    source="spring.profiles.active"/>

    <!-- ===================== -->
    <!-- JSON CONSOLE APPENDER -->
    <!-- ===================== -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>

                <!-- Timestamp -->
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>

                <!-- Log level -->
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>

                <!-- Service / environment -->
                <pattern>
                    <pattern>
                        {
                            "service": "${SERVICE_NAME}",
                            "env": "${ACTIVE_PROFILE:-default}"
                        }
                    </pattern>
                </pattern>

                <!-- Logger + thread -->
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>

                <!-- Message -->
                <message>
                    <fieldName>message</fieldName>
                </message>

                <!-- MDC: trace / correlation -->
                <mdc>
                    <fieldName>mdc</fieldName>
                </mdc>
                
                <!-- Exception -->
                <stackTrace>
                    <fieldName>errorStack</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/${SERVICE_NAME}.jsonl</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/${SERVICE_NAME}.%d{yyyy-MM-dd}.jsonl</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp/>
                <logLevel/>
                <loggerName/>
                <message/>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>


    <!-- =========== -->
    <!-- LOG LEVELS  -->
    <!-- =========== -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
